---
import '@/styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Alex Morgan — Product Engineer & Portfolio",
  description = "Minimalist light-mode glassmorphic portfolio landing page built with Astro, React, and ShadCN UI.",
} = Astro.props;
---

<!ts-html>
<html lang="en" className="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body className="min-h-screen bg-slate-50 text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] relative overflow-x-hidden selection:bg-slate-200 selection:text-slate-900">
    <!-- Ambient Light Backdrop Glow Blobs -->
    <div className="fixed top-[-10%] left-[-5%] w-[500px] h-[500px] bg-gradient-to-tr from-indigo-200/40 via-sky-100/50 to-slate-100/30 rounded-full blur-[100px] pointer-events-none -z-10"></div>
    <div className="fixed bottom-[-10%] right-[-5%] w-[600px] h-[600px] bg-gradient-to-br from-slate-200/40 via-indigo-100/30 to-slate-100/20 rounded-full blur-[120px] pointer-events-none -z-10"></div>

    <slot />
  </body>
</html>
