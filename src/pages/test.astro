---
import Layout from '@/layouts/Layout.astro';
import { Header } from '@/components/Header';
import { Footer } from '@/components/Footer';
import { ComponentPlayground } from '@/components/ComponentPlayground';
---

<Layout title="Design System & Component Playground — Cato Cannizzo">
  <Header client:load />

  <main class="notebook-grid relative z-10 w-full px-6 sm:pl-32 sm:pr-8 py-line-2">
    <ComponentPlayground client:load />
  </main>

  <Footer />
</Layout>
