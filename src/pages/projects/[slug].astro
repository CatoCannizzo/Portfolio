---
import Layout from '@/layouts/Layout.astro';
import { Header } from '@/components/Header';
import { Footer } from '@/components/Footer';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Card } from '@/components/ui/card';
import {
  DoodleUnderline,
  DoodleCheck,
} from '@/components/Doodles';
import { projectsData } from '@/data/projects';
import { ArrowLeft, ArrowUpRight, ExternalLink } from 'lucide-react';

export function getStaticPaths() {
  return projectsData.map((project, index) => {
    const prev = index > 0 ? projectsData[index - 1] : null;
    const next = index < projectsData.length - 1 ? projectsData[index + 1] : null;
    return {
      params: { slug: project.slug },
      props: { project, prev, next },
    };
  });
}

const { project, prev, next } = Astro.props;
---

<Layout title={`${project.title} — Case Study Notes`}>
  <Header client:load />

  <main class="notebook-grid relative z-10 w-full">
    <div class="max-w-4xl mx-auto px-6 sm:pl-32 sm:pr-8 py-line-2 md:py-line-3">
    
    <!-- Top Breadcrumb Navigation -->
    <div class="flex items-center justify-between mb-line-1 pb-line-0.5 border-b border-dashed border-slate-300">
      <Button variant="doodle" size="sm" asChild className="group font-sketch text-0.375 font-bold">
        <a href="/#projects" class="flex items-center gap-2">
          <ArrowLeft class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
          <span>← Back to Notebook</span>
        </a>
      </Button>

      <div class="flex items-center gap-2">
        <span class="font-sketch text-0.375 text-slate-500 uppercase tracking-widest">
          Project Case Study
        </span>
      </div>
    </div>

    <!-- Project Header & Title Card -->
    <div class="relative mb-line-1.5">
      <Card
        fixture="tape"
        fixtureProps={{ tapeVariant: project.tapeColor || 'yellow', size: 'lg' }}
        borderStyle="thick"
        shadowStyle="lg"
        className="bg-white p-line-1 sm:p-line-1.5 relative"
      >
        <div class="flex flex-wrap items-center justify-between gap-3 mb-line-0.5">
          <div class="flex items-center gap-2">
            <Badge variant={project.tapeColor || 'yellow'}>
              {project.category}
            </Badge>
            <span class="font-hand text-0.5 text-slate-500">• Entry #{project.id}</span>
          </div>

          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-sketch text-0.375 font-bold text-blue-600 hover:text-blue-800 underline underline-offset-4"
          >
            <span>Live Repo / Prototype</span>
            <ExternalLink class="h-3.5 w-3.5" />
          </a>
        </div>

        <div class="relative inline-block mb-line-1">
          <h1 class="text-1.5 md:text-2 font-bold text-slate-900 tracking-tight font-sans">
            {project.title}
          </h1>
          <DoodleUnderline color="#f43f5e" className="absolute -bottom-2 left-0 w-full" />
        </div>

        <p class="text-0.5 md:text-0.75 text-slate-700 font-normal max-w-2xl font-sans mb-line-1">
          {project.description}
        </p>

        <!-- Project Metadata Index Card -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-yellow-50/70 sketch-box-sm text-0.375 font-sans">
          <div>
            <span class="font-sketch block text-slate-500 font-bold uppercase">Role</span>
            <span class="font-bold text-slate-900">Lead Architecture</span>
          </div>
          <div>
            <span class="font-sketch block text-slate-500 font-bold uppercase">Timeline</span>
            <span class="font-bold text-slate-900">3 Months</span>
          </div>
          <div>
            <span class="font-sketch block text-slate-500 font-bold uppercase">Impact</span>
            <span class="font-bold text-slate-900">{project.metrics || 'High Performance'}</span>
          </div>
          <div>
            <span class="font-sketch block text-slate-500 font-bold uppercase">Platform</span>
            <span class="font-bold text-slate-900">Web / Cloud</span>
          </div>
        </div>
      </Card>
    </div>

    <!-- Case Study Sections -->
    <div class="space-y-line-1.5">
      
      <!-- Section 1: Overview & Challenges -->
      <Card variant="default" className="p-line-1 sm:p-line-1.5">
        <div class="flex items-center gap-2 mb-line-0.5">
          <span class="font-sketch text-0.375 font-bold uppercase text-slate-400">01 // Problem Statement</span>
        </div>
        <h2 class="text-1 font-bold text-slate-900 font-sans mb-line-0.5">
          The Challenge &amp; Architecture Goals
        </h2>
        <p class="text-0.5 text-slate-700 font-sans mb-line-0.5">
          Modern web applications frequently suffer from bloated JavaScript payloads, excessive DOM reflows, and slow initial render cycles. For <span class="font-bold">{project.title}</span>, the goal was to build a streamlined experience that maximizes speed, accessibility, and intuitive tactile micro-interactions without compromising functionality.
        </p>
        <p class="text-0.5 text-slate-700 font-sans">
          {project.details}
        </p>
      </Card>

      <!-- Section 2: Sketch Wireframe Placeholder -->
      <Card
        fixture="paperclip"
        fixtureProps={{ position: 'top-right' }}
        variant="dashed"
        shadowStyle="none"
        className="p-line-1 sm:p-line-1.5 text-center"
      >
        <span class="font-sketch text-0.375 uppercase tracking-widest text-slate-400 font-bold block mb-line-0.5">
          Architecture Blueprint &amp; Layout Diagram
        </span>
        <div class="h-48 sm:h-64 border-2 border-dashed border-slate-300 sketch-box-sm flex flex-col items-center justify-center p-6 bg-slate-50/50">
          <p class="font-sketch text-0.5 font-bold text-slate-700 mb-1">
            [ Interactive Wireframe &amp; Component Schema ]
          </p>
          <p class="font-hand text-0.5 text-slate-500 max-w-sm">
            Modular reactive islands rendered via Astro with selective hydration and zero-waste client bundles.
          </p>
        </div>
      </Card>

      <!-- Section 3: Technical Implementation Checklist -->
      <Card className="bg-white p-line-1 sm:p-line-1.5">
        <div class="flex items-center gap-2 mb-line-0.5">
          <span class="font-sketch text-0.375 font-bold uppercase text-slate-400">02 // Key Features</span>
        </div>
        <h2 class="text-1 font-bold text-slate-900 font-sans mb-line-0.5">
          Engineering Highlights
        </h2>

        <div class="space-y-3">
          <div class="flex items-start gap-3 p-3 bg-yellow-50/50 sketch-box-sm">
            <div class="mt-0.5">
              <DoodleCheck checked={true} />
            </div>
            <div>
              <h3 class="font-sans font-bold text-0.5 text-slate-900">Zero-Layout Shift Rendering</h3>
              <p class="text-0.375 text-slate-600 font-sans mt-0.5">Engineered deterministic container constraints to achieve a 0.00 CLS score.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 p-3 bg-sky-50/50 sketch-box-sm">
            <div class="mt-0.5">
              <DoodleCheck checked={true} />
            </div>
            <div>
              <h3 class="font-sans font-bold text-0.5 text-slate-900">Accessible Keyboard Navigation</h3>
              <p class="text-0.375 text-slate-600 font-sans mt-0.5">Complies fully with WCAG 2.1 AAA contrast and focus trap requirements.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 p-3 bg-rose-50/50 sketch-box-sm">
            <div class="mt-0.5">
              <DoodleCheck checked={true} />
            </div>
            <div>
              <h3 class="font-sans font-bold text-0.5 text-slate-900">Sub-100ms Hydration</h3>
              <p class="text-0.375 text-slate-600 font-sans mt-0.5">Optimized Astro island hydration triggers using IntersectionObserver.</p>
            </div>
          </div>
        </div>

        <div class="mt-line-1 pt-line-0.5 border-t border-dashed border-slate-200 flex flex-wrap gap-2">
          <span class="font-sketch text-0.375 font-bold text-slate-500 self-center mr-2">Technologies Used:</span>
          {project.tags.map((tag) => (
            <Badge variant="yellow">
              #{tag}
            </Badge>
          ))}
        </div>
      </Card>

      <!-- Bottom Pagination Links -->
      <div class="pt-line-1 flex flex-col sm:flex-row items-center justify-between gap-4 border-t-2 border-dashed border-slate-300">
        {prev ? (
          <Button variant="doodle" size="sm" asChild className="w-full sm:w-auto font-sketch font-bold">
            <a href={`/projects/${prev.slug}`}>
              <span>← {prev.title}</span>
            </a>
          </Button>
        ) : (
          <div />
        )}

        <a
          href="/#projects"
          class="font-hand text-0.5 text-slate-600 hover:text-slate-900 underline underline-offset-4"
        >
          Return to Table of Contents
        </a>

        {next ? (
          <Button variant="doodle" size="sm" asChild className="w-full sm:w-auto font-sketch font-bold">
            <a href={`/projects/${next.slug}`}>
              <span>{next.title} →</span>
            </a>
          </Button>
        ) : (
          <div />
        )}
      </div>

    </div>
  </main>

  <Footer />
</Layout>
